# What EAS Build leaves out of the upload. A copy of .gitignore: unlike git, EAS needs
# google-services.json (kept out of the public repo by .git/info/exclude).

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# Firebase service account key (push setup). Never commit it.
*-firebase-adminsdk-*.json
