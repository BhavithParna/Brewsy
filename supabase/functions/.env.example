# Server secrets for the Brewsy functions.
#
# On Supabase these are set with:
#   npx supabase secrets set --env-file supabase/functions/.env
# For local runs, copy this file to supabase/functions/.env (git-ignored).
# Never put real values in this example file.

# ─── Required ────────────────────────────────────────────────────────────────

# Long random string. The timer sends it in the x-brewsy-secret header.
# Make one with:  openssl rand -hex 32
CRON_SECRET=

# The AI that writes the edition. Set ONE of these.
# Claude (recommended): https://platform.claude.com → API keys. Default model: claude-opus-5-5
ANTHROPIC_API_KEY=
# Gemini (free tier): https://aistudio.google.com/apikey. Used when there's no Anthropic key.
# GEMINI_API_KEY=

# ─── Audio briefing voice (see _shared/audio-config.ts for costs) ───────────

# openai (default) | elevenlabs | none (the phone reads the script aloud)
# TTS_PROVIDER=openai
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# ElevenLabs: https://elevenlabs.io → Developers → API keys
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# ─── Optional (remove the # to use) ─────────────────────────────────────────

# Another Claude model, e.g. the cheaper claude-sonnet-5-5
# CLAUDE_MODEL=claude-sonnet-5-5
# Force a provider: anthropic | gemini
# LLM_PROVIDER=anthropic
# Another Gemini model. Default: gemini-3.8-flash
# GEMINI_MODEL=gemini-flash-latest

# SEC 8-K filings: the SEC requires a contact email in every request.
# Without it, that source is skipped (not counted as a failure).
# SEC_CONTACT_EMAIL=

# Alert emails via Resend (https://resend.com). Without these, alerts arrive as a push only.
# ALERT_EMAIL must be the address you signed up to Resend with, unless you verify a domain.
# RESEND_API_KEY=
# ALERT_EMAIL=
# ALERT_FROM=Brewsy <onboarding@resend.dev>

# Only if you turned on "Enhanced push security" in Expo.
# EXPO_ACCESS_TOKEN=
