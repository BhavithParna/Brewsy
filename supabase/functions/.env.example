# Server secrets for the Brewsy functions.
#
# On Supabase these are set with:
#   npx supabase secrets set --env-file supabase/functions/.env
# For local runs, copy this file to supabase/functions/.env (git-ignored).
# Never put real values in this example file.

# ─── Required ────────────────────────────────────────────────────────────────

# Long random string. The timer sends it in the x-brewsy-secret header.
# Make one with:  openssl rand -hex 32
CRON_SECRET=

# The AI, all on free tiers (docs/BACKEND_SETUP.md, step 2). Which one does what: _shared/llm.ts.
# Groq: https://console.groq.com/keys (scripts, local sections, checks, Go deeper, Ask)
GROQ_API_KEY=
# Cloudflare Workers AI (the world edition, and overflow): the account ID from the dashboard,
# and an API token with Workers AI Read + Workers AI Edit.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# No voice service: the phone reads the script aloud ($0).
TTS_PROVIDER=none

# ─── Optional (remove the # to use) ─────────────────────────────────────────

# Another route for a purpose (edition, script, refresh, region, region-stories, deeper, ask).
# Claude ("anthropic"), Gemini and Mistral are only ever used when named here; Ask never
# goes to Mistral or Gemini.
# LLM_ROUTES={"deeper":["cloudflare","groq:openai/gpt-oss-120b"]}
# SambaNova is only used when named in LLM_ROUTES (its free tier refused card-less keys in Oct 2026).
# SAMBANOVA_API_KEY=
# OPENROUTER_API_KEY=

# Daily caps (rolling 24 hours). Defaults shown.
# ASK_CAP_DEVICE=5
# ASK_CAP_TOTAL=60
# DEEPER_CAP_DEVICE=8
# DEEPER_CAP_TOTAL=30
# AI_CAP_NO_DEVICE=10

# SEC 8-K filings: the SEC requires a contact email in every request.
# Without it, that source is skipped (not counted as a failure).
# SEC_CONTACT_EMAIL=

# Alert emails via Resend (https://resend.com). Without these, alerts arrive as a push only.
# ALERT_EMAIL must be the address you signed up to Resend with, unless you verify a domain.
# RESEND_API_KEY=
# ALERT_EMAIL=
# ALERT_FROM=Brewsy <onboarding@resend.dev>

# Only if you turned on "Enhanced push security" in Expo.
# EXPO_ACCESS_TOKEN=

# ─── Paid, off by default ───────────────────────────────────────────────────
# Only used if LLM_ROUTES names them (AI) or TTS_PROVIDER picks them (voice).
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ELEVENLABS_API_KEY=
