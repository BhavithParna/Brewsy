# Copy this file to `.env` (same folder) and fill it in to use your own backend.
# See docs/BACKEND_SETUP.md, step 10. Without a .env the app shows the sample edition.
#
# Only the Supabase *publishable* key goes here (starts with sb_publishable_).
# Never the secret key: everything in the app can be read by anyone who has it.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_...
